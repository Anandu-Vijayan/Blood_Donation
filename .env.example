# Copy to .env for local dev — NEVER commit .env
#   cp .env.example .env
# Production: set values in Render Dashboard → Environment

# =============================================================================
# Supabase (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# For npm run migrate only, if migrate fails use Session pooler (port 5432):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# =============================================================================
# Upstash Redis (BullMQ notification queue)
# =============================================================================
# Upstash → Connect → "ioredis" tab (NOT the REST URL/token):
REDIS_URL=rediss://default:YOUR_IOREDIS_PASSWORD@normal-sheepdog-67983.upstash.io:6379

# =============================================================================
# Firebase Auth (API verifies client ID tokens — Firebase Admin SDK)
# =============================================================================
FIREBASE_PROJECT_ID=reddar-79c00

# Option A — path to service account JSON (recommended local):
GOOGLE_APPLICATION_CREDENTIALS=

# Option B — inline JSON one line (use on Render):
FIREBASE_SERVICE_ACCOUNT_JSON=

# Client app only (mobile/web — not read by this API):
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=reddar-79c00.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=reddar-79c00

# =============================================================================
# App security & server
# =============================================================================
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX

PORT=3000
NODE_ENV=development
RUN_MIGRATIONS_ON_START=true

# CORS (production on Render)
# CORS_ORIGINS=

# =============================================================================
# Optional
# =============================================================================
# EXPO_ACCESS_TOKEN=
