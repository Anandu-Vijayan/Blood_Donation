{
  "name": "blood-donation-api",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "pnpm --filter api dev",
    "build": "pnpm run build:shared && pnpm --filter api build",
    "build:shared": "pnpm --filter @blood-donation/shared build",
    "start": "pnpm --filter api start",
    "migrate": "pnpm --filter api migrate",
    "typecheck": "pnpm run build:shared && pnpm --filter api typecheck && pnpm --filter @blood-donation/shared typecheck",
    "lint": "eslint apps/api/src packages/shared/src",
    "test": "pnpm --filter api test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.18.0"
  }
}
