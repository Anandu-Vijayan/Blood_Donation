{
  "name": "blood-donation-api",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm --workspace apps/api run dev",
    "build": "npm run build:shared && npm --workspace apps/api run build",
    "build:shared": "npm --workspace @blood-donation/shared run build",
    "start": "npm --workspace apps/api run start",
    "migrate": "npm --workspace apps/api run migrate",
    "typecheck": "npm run build:shared && npm --workspace apps/api run typecheck && npm --workspace @blood-donation/shared run typecheck",
    "lint": "eslint apps/api/src packages/shared/src",
    "test": "npm --workspace apps/api run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.18.0"
  }
}
